# 大模型配置（OpenAI 兼容协议）
# 任何兼容 OpenAI 协议的服务都可以接入（七牛云 / 硅基流动 / DeepSeek 官方等）

# 模型提供商: siliconflow（走下方 SILICONFLOW_* 配置）| deepseek（走 DEEPSEEK_* 配置）
MODEL_PROVIDER=siliconflow

# ====== OpenAI 兼容服务配置（示例：七牛云 AI 大模型平台）======
# 从你的服务平台控制台复制这三项
SILICONFLOW_API_KEY=your_api_key_here
SILICONFLOW_MODEL=deepseek/deepseek-v4-flash-20260731
SILICONFLOW_BASE_URL=https://api.qnaigc.com/v1

# ====== DeepSeek 官方示例（备用）======
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 服务器配置
PORT=3000
NODE_ENV=development
